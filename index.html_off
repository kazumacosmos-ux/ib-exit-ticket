<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>1-B出口 搭乗券予約</title>
  <style>
/* =========================================
   1-B出口 AIRLINES
   DEGUCHI DREAM SKYLINE AIRLINES
   PREMIUM BOARDING PASS RESERVATION
   ========================================= */

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  min-height: 100%;
}

html {
  background: #071426;
}

body {
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Helvetica Neue",
    "Hiragino Kaku Gothic ProN",
    "Yu Gothic",
    YuGothic,
    sans-serif;

  min-height: 100vh;

  color: #ffffff;

  background:
    radial-gradient(
      ellipse at 50% -10%,
      rgba(94, 156, 220, 0.45) 0%,
      rgba(36, 74, 121, 0.25) 28%,
      transparent 55%
    ),
    linear-gradient(
      180deg,
      #10294a 0%,
      #0b1d36 38%,
      #071426 100%
    );

  padding: 0 16px 70px;
}

/* =========================================
   ページ全体
   ========================================= */

.container {
  width: min(100%, 520px);
  margin: 0 auto;
}

/* =========================================
   ヒーローヘッダー
   ========================================= */

.airline-header {
  position: relative;

  padding: 42px 8px 30px;

  text-align: center;

  overflow: hidden;
}

.airline-header::before {
  content: "";

  position: absolute;

  width: 260px;
  height: 120px;

  left: 50%;
  top: -75px;

  transform: translateX(-50%);

  background: rgba(255, 255, 255, 0.1);

  filter: blur(35px);

  border-radius: 50%;
}

.airline-name {
  position: relative;

  margin: 0 0 8px;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: 0.24em;

  color: rgba(255, 255, 255, 0.68);
}

.page-title {
  position: relative;

  margin: 0;

  font-size: 34px;

  line-height: 1.12;

  font-weight: 900;

  letter-spacing: 0.04em;

  color: #ffffff;

  text-shadow:
    0 4px 20px rgba(0, 0, 0, 0.25);
}

.airline-subtitle {
  position: relative;

  margin: 10px 0 0;

  font-size: 12px;

  font-weight: 600;

  letter-spacing: 0.14em;

  color: rgba(255, 255, 255, 0.72);
}

.airline-tagline {
  position: relative;

  margin: 18px 0 0;

  font-size: 10px;

  font-weight: 700;

  letter-spacing: 0.18em;

  color: rgba(255, 255, 255, 0.42);

  text-transform: uppercase;
}

/* =========================================
   航空会社ライン
   ========================================= */

.airline-divider {
  display: flex;

  align-items: center;

  gap: 12px;

  margin: 0 0 22px;
}

.airline-divider::before,
.airline-divider::after {
  content: "";

  flex: 1;

  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.2)
    );
}

.airline-divider::after {
  background:
    linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.2),
      transparent
    );
}

.airline-divider span {
  font-size: 9px;

  font-weight: 800;

  letter-spacing: 0.18em;

  color: rgba(255, 255, 255, 0.45);
}

/* =========================================
   予約エリア
   ========================================= */

#reserveArea {
  position: relative;

  overflow: hidden;

  background:
    linear-gradient(
      180deg,
      #ffffff 0%,
      #f7f9fc 100%
    );

  color: #111827;

  border-radius: 28px;

  padding: 30px 25px 27px;

  box-shadow:
    0 30px 70px rgba(0, 0, 0, 0.34),
    0 8px 24px rgba(0, 0, 0, 0.18);

  margin-bottom: 30px;
}

/* 上部の航空券ライン */

#reserveArea::before {
  content: "DEGUCHI DREAM SKYLINE AIRLINES";

  display: block;

  margin-bottom: 9px;

  font-size: 9px;

  font-weight: 900;

  letter-spacing: 0.2em;

  color: #64748b;
}

/* 上部の青ライン */

#reserveArea::after {
  content: "";

  display: block;

  position: absolute;

  left: 0;
  right: 0;
  top: 0;

  height: 5px;

  background:
    linear-gradient(
      90deg,
      #152d53,
      #5d86b8,
      #152d53
    );
}

#reserveArea h2 {
  margin: 0 0 24px;

  font-size: 27px;

  line-height: 1.2;

  font-weight: 900;

  letter-spacing: 0.025em;

  color: #101d34;
}

/* =========================================
   予約フォーム内の航空券情報
   ========================================= */

.flight-preview {
  display: grid;

  grid-template-columns: 1fr auto 1fr;

  align-items: center;

  gap: 10px;

  margin: 0 0 23px;

  padding: 18px 16px;

  border-radius: 17px;

  background:
    linear-gradient(
      135deg,
      #eef4fb,
      #f7f9fc
    );

  border: 1px solid #e0e7f0;
}

.flight-preview > div {
  min-width: 0;
}

.flight-preview span {
  display: block;

  margin-bottom: 4px;

  color: #7a8799;

  font-size: 9px;

  font-weight: 800;

  letter-spacing: 0.12em;
}

.flight-preview strong {
  display: block;

  color: #172744;

  font-size: 21px;

  font-weight: 900;

  letter-spacing: 0.05em;
}

.flight-preview .flight-arrow {
  color: #7890ad;

  font-size: 18px;

  font-weight: 900;

  text-align: center;
}

/* =========================================
   ラベル
   ========================================= */

#reserveArea label {
  display: block;

  margin: 17px 0 7px;

  color: #586579;

  font-size: 12px;

  font-weight: 800;

  letter-spacing: 0.03em;
}

/* =========================================
   入力欄
   ========================================= */

#reserveArea input,
#reserveArea select {
  width: 100%;

  min-height: 50px;

  padding: 0 15px;

  border: 1px solid #d6dde7;

  border-radius: 13px;

  outline: none;

  background: #f7f9fc;

  color: #142039;

  font-family: inherit;

  font-size: 16px;

  font-weight: 500;

  -webkit-appearance: none;
  appearance: none;

  transition:
    border-color 0.15s ease,
    background 0.15s ease,
    box-shadow 0.15s ease;
}

#reserveArea input::placeholder {
  color: #9aa5b5;
}

#reserveArea input:focus,
#reserveArea select:focus {
  border-color: #6885ad;

  background: #ffffff;

  box-shadow:
    0 0 0 3px rgba(91, 124, 164, 0.13);
}

/* =========================================
   セレクトボックス
   ========================================= */

#reserveArea select {
  cursor: pointer;

  padding-right: 42px;

  background-image:
    linear-gradient(
      45deg,
      transparent 50%,
      #61738d 50%
    ),
    linear-gradient(
      135deg,
      #61738d 50%,
      transparent 50%
    );

  background-position:
    calc(100% - 19px) 22px,
    calc(100% - 13px) 22px;

  background-size:
    6px 6px,
    6px 6px;

  background-repeat: no-repeat;
}

/* =========================================
   時間帯情報
   ========================================= */

.slot-info {
  margin: 11px 0 0;

  padding: 11px 14px;

  border-radius: 11px;

  background: #eef3f8;

  color: #59687c;

  font-size: 13px;

  font-weight: 700;

  line-height: 1.5;

  text-align: center;
}

/* =========================================
   予約ボタン
   ========================================= */

#reserve {
  position: relative;

  overflow: hidden;

  width: 100%;

  min-height: 56px;

  margin-top: 23px;

  border: none;

  border-radius: 15px;

  background:
    linear-gradient(
      135deg,
      #19365f 0%,
      #0e1d36 100%
    );

  color: #ffffff;

  font-family: inherit;

  font-size: 16px;

  font-weight: 900;

  letter-spacing: 0.06em;

  cursor: pointer;

  box-shadow:
    0 10px 22px rgba(19, 43, 77, 0.27);

  transition:
    transform 0.15s ease,
    box-shadow 0.15s ease,
    opacity 0.15s ease;
}

#reserve::before {
  content: "";

  position: absolute;

  top: 0;
  bottom: 0;

  left: -70%;

  width: 45%;

  transform: skewX(-20deg);

  background: rgba(255, 255, 255, 0.08);

  transition: left 0.45s ease;
}

#reserve:active {
  transform: translateY(1px);

  box-shadow:
    0 5px 12px rgba(19, 43, 77, 0.2);
}

#reserve:active::before {
  left: 120%;
}

#reserve:disabled {
  opacity: 0.48;

  cursor: default;

  box-shadow: none;
}

/* =========================================
   エラー
   ========================================= */

#error {
  min-height: 20px;

  margin: 12px 0 0;

  color: #c13e47;

  font-size: 13px;

  font-weight: 700;

  line-height: 1.5;

  text-align: center;
}

/* =========================================
   予約エリア下部
   ========================================= */

.booking-note {
  margin: 18px 2px 0;

  color: #7a8798;

  font-size: 10px;

  line-height: 1.7;

  text-align: center;
}

/* =========================================
   予約済みエリア
   ========================================= */

#reservationArea {
  margin-top: 26px;
}

#reservationArea > h2 {
  margin: 0 0 17px;

  color: #ffffff;

  font-size: 24px;

  font-weight: 900;

  letter-spacing: 0.03em;

  text-shadow:
    0 3px 15px rgba(0, 0, 0, 0.25);
}

/* =========================================
   搭乗券
   ========================================= */

.boarding-pass {
  position: relative;

  width: 100%;

  overflow: hidden;

  margin-bottom: 25px;

  border-radius: 24px;

  background: #ffffff;

  color: #111827;

  box-shadow:
    0 30px 65px rgba(0, 0, 0, 0.38),
    0 8px 22px rgba(0, 0, 0, 0.18);
}

/* =========================================
   搭乗券 ヘッダー
   ========================================= */

.boarding-pass-header {
  position: relative;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  min-height: 92px;

  padding: 21px 22px 20px;

  background:
    linear-gradient(
      90deg,
      #063e69 0%,
      #0b78a9 50%,
      #39b9e6 100%
    );

  color: #ffffff;
}

.boarding-pass-header::before {
  content: "DEGUCHI DREAM SKYLINE AIRLINES";

  position: absolute;

  left: 22px;
  top: 9px;

  font-size: 7px;

  font-weight: 800;

  letter-spacing: 0.18em;

  color: rgba(255, 255, 255, 0.42);
}

.boarding-pass-header::after {
  content: "";

  position: absolute;

  left: 22px;
  right: 22px;
  bottom: 0;

  height: 1px;

  background: rgba(255, 255, 255, 0.15);
}

.boarding-pass-header > div {
  min-width: 0;
}

.boarding-pass-header h2 {
  margin: 5px 0 0;

  color: #ffffff;

  font-size: 20px;

  font-weight: 900;

  line-height: 1.2;

  letter-spacing: 0.04em;
}

.boarding-pass-header p {
  margin: 5px 0 0;

  color: rgba(255, 255, 255, 0.66);

  font-size: 10px;

  font-weight: 600;

  letter-spacing: 0.1em;
}

.boarding-pass-header strong {
  flex-shrink: 0;

  color: #ffffff;

  font-size: 16px;

  font-weight: 900;

  letter-spacing: 0.08em;
}

/* =========================================
   搭乗券 メイン
   ========================================= */

.boarding-pass-main {
  position: relative;

  padding: 24px 22px 22px;

  background:
    linear-gradient(
      180deg,
      #ffffff 0%,
      #f7f9fc 100%
    );
}

/* =========================================
   ご来場時間
   ========================================= */

.boarding-arrival {
  padding-bottom: 21px;

  border-bottom: 1px solid #e3e8ef;
}

.boarding-arrival span {
  display: block;

  margin-bottom: 7px;

  color: #778397;

  font-size: 9px;

  font-weight: 900;

  letter-spacing: 0.16em;

  text-transform: uppercase;
}

.boarding-arrival strong {
  display: block;

  color: #142442;

  font-size: 29px;

  line-height: 1.15;

  font-weight: 900;

  letter-spacing: 0.01em;
}

/* =========================================
   搭乗情報グリッド
   ========================================= */

.boarding-info-grid {
  display: grid;

  grid-template-columns: 1fr 1fr;

  margin-top: 2px;
}

.boarding-info-grid > div {
  min-width: 0;

  padding: 17px 0 15px;

  border-bottom: 1px solid #e3e8ef;
}

.boarding-info-grid > div:nth-child(odd) {
  padding-right: 14px;

  border-right: 1px solid #e3e8ef;
}

.boarding-info-grid > div:nth-child(even) {
  padding-left: 14px;
}

.boarding-info-grid span {
  display: block;

  margin-bottom: 5px;

  color: #7c8798;

  font-size: 9px;

  font-weight: 900;

  letter-spacing: 0.13em;
}

.boarding-info-grid strong {
  display: block;

  color: #182641;

  font-size: 16px;

  font-weight: 900;

  line-height: 1.3;
}

/* =========================================
   代表者
   ========================================= */

.boarding-pass-passenger {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 12px;

  padding-top: 18px;
}

.boarding-pass-passenger span {
  flex-shrink: 0;

  color: #7b8798;

  font-size: 10px;

  font-weight: 900;

  letter-spacing: 0.13em;
}

.boarding-pass-passenger strong {
  min-width: 0;

  color: #182641;

  font-size: 17px;

  font-weight: 900;

  line-height: 1.3;

  text-align: right;

  word-break: break-all;
}

/* =========================================
   搭乗券 フッター
   ========================================= */

.boarding-pass-footer {
  position: relative;

  padding: 20px 22px 22px;

  background:
    linear-gradient(
      180deg,
      #eef2f6,
      #e9edf2
    );

  border-top: 1px dashed #bfc7d2;
}

/* 左右のミシン目 */

.boarding-pass-footer::before,
.boarding-pass-footer::after {
  content: "";

  position: absolute;

  top: -11px;

  width: 22px;
  height: 22px;

  border-radius: 50%;

  background: #0a172b;
}

.boarding-pass-footer::before {
  left: -11px;
}

.boarding-pass-footer::after {
  right: -11px;
}

/* =========================================
   案内文
   ========================================= */

.boarding-note {
  margin: 0 0 17px;

  color: #536176;

  font-size: 12px;

  font-weight: 600;

  line-height: 1.7;

  text-align: center;
}

/* =========================================
   バーコード
   ========================================= */

.boarding-barcode {
  display: flex;

  align-items: stretch;

  justify-content: center;

  gap: 3px;

  height: 36px;

  margin: 0 0 17px;

  overflow: hidden;
}

.boarding-barcode span {
  display: block;

  width: 2px;

  height: 100%;

  background: #15233b;
}

.boarding-barcode span:nth-child(2n) {
  width: 4px;
}

.boarding-barcode span:nth-child(3n) {
  width: 1px;
}

.boarding-barcode span:nth-child(5n) {
  width: 5px;
}

.boarding-barcode span:nth-child(7n) {
  width: 2px;
}

/* =========================================
   キャンセルボタン
   ========================================= */

.cancel-reservation {
  display: block;

  width: 100%;

  min-height: 43px;

  border: 1px solid #d2d8e0;

  border-radius: 12px;

  background: rgba(255, 255, 255, 0.82);

  color: #667286;

  font-family: inherit;

  font-size: 12px;

  font-weight: 800;

  cursor: pointer;

  transition:
    background 0.15s ease,
    color 0.15s ease,
    border-color 0.15s ease;
}

.cancel-reservation:active {
  background: #e7ebf0;

  color: #435067;

  border-color: #c1c9d4;
}

/* =========================================
   予約内容変更ボタン
   ========================================= */

.edit-reservation {
  display: block;
  width: 100%;
  min-height: 43px;
  margin-bottom: 10px;
  border: 1px solid #d2d8e0;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.82);
  color: #667286;
  font-family: inherit;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}

.edit-reservation:active {
  background: #e7ebf0;
  color: #435067;
  border-color: #c1c9d4;
}

/* =========================================
   受付停止
   ========================================= */

#closedArea {
  position: relative;

  overflow: hidden;

  margin-top: 10px;

  padding: 32px 24px;

  border-radius: 25px;

  background:
    linear-gradient(
      180deg,
      #ffffff 0%,
      #f4f7fa 100%
    );

  color: #111827;

  text-align: center;

  box-shadow:
    0 25px 55px rgba(0, 0, 0, 0.3);
}

#closedArea::before {
  content: "DEGUCHI DREAM SKYLINE AIRLINES";

  display: block;

  margin-bottom: 13px;

  color: #728097;

  font-size: 8px;

  font-weight: 900;

  letter-spacing: 0.18em;
}

#closedArea h2 {
  margin: 0 0 11px;

  color: #172641;

  font-size: 23px;

  font-weight: 900;
}

#closedArea p {
  margin: 0;

  color: #667387;

  font-size: 13px;

  font-weight: 600;

  line-height: 1.7;
}

/* =========================================
   下部フッター
   ========================================= */

.site-footer {
  padding: 30px 10px 0;

  color: rgba(255, 255, 255, 0.34);

  font-size: 8px;

  font-weight: 700;

  line-height: 1.7;

  letter-spacing: 0.12em;

  text-align: center;
}

/* =========================================
   スマートフォン
   ========================================= */

@media (max-width: 520px) {

  body {
    padding:
      0 12px
      50px;
  }

  .container {
    width: 100%;
  }

  .airline-header {
    padding:
      30px 5px 25px;
  }

  .airline-name {
    font-size: 8px;

    letter-spacing: 0.18em;
  }

  .page-title {
    font-size: 29px;
  }

  .airline-subtitle {
    font-size: 10px;

    letter-spacing: 0.1em;
  }

  .airline-tagline {
    margin-top: 14px;

    font-size: 8px;
  }

  #reserveArea {
    padding:
      27px 18px 23px;

    border-radius: 23px;
  }

  #reserveArea h2 {
    font-size: 24px;
  }

  .flight-preview {
    padding: 15px 13px;
  }

  .flight-preview strong {
    font-size: 18px;
  }

  .boarding-pass {
    border-radius: 21px;
  }

  .boarding-pass-header {
    min-height: 88px;

    padding:
      20px 18px 18px;
  }

  .boarding-pass-header::before {
    left: 18px;
  }

  .boarding-pass-header::after {
    left: 18px;
    right: 18px;
  }

  .boarding-pass-header h2 {
    font-size: 18px;
  }

  .boarding-pass-header p {
    font-size: 9px;
  }

  .boarding-pass-header strong {
    font-size: 13px;
  }

  .boarding-pass-main {
    padding:
      21px 18px;
  }

  .boarding-arrival strong {
    font-size: 25px;
  }

  .boarding-pass-footer {
    padding:
      18px;
  }
}

/* =========================================
   小さいスマートフォン
   ========================================= */

@media (max-width: 380px) {

  body {
    padding-left: 9px;
    padding-right: 9px;
  }

  .airline-header {
    padding-top: 25px;
  }

  .page-title {
    font-size: 26px;
  }

  #reserveArea {
    padding-left: 15px;
    padding-right: 15px;
  }

  .flight-preview {
    grid-template-columns: 1fr;

    text-align: center;
  }

  .flight-preview .flight-arrow {
    transform: rotate(90deg);
  }

  .boarding-info-grid {
    grid-template-columns: 1fr;
  }

  .boarding-info-grid > div:nth-child(odd) {
    padding-right: 0;

    border-right: none;
  }

  .boarding-info-grid > div:nth-child(even) {
    padding-left: 0;
  }

  .boarding-pass-passenger {
    align-items: flex-start;

    flex-direction: column;

    gap: 5px;
  }

  .boarding-pass-passenger strong {
    text-align: left;
  }
}

/* ===== お客さん.html のインラインCSS ===== */


    * {
      box-sizing: border-box;
    }


    html {
      min-height: 100%;
    }


    body {

      margin: 0;

      min-height: 100vh;

      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Helvetica Neue",
        "Yu Gothic",
        "Hiragino Kaku Gothic ProN",
        Meiryo,
        sans-serif;

      color: #123a59;

      /*
       * 空港ターミナルをイメージした背景
       */
      background:

        /* ガラス天井の光 */
        radial-gradient(
          ellipse at 50% -10%,
          rgba(255,255,255,0.95) 0%,
          rgba(255,255,255,0.35) 35%,
          transparent 65%
        ),

        /* 空港の照明 */
        radial-gradient(
          circle at 15% 30%,
          rgba(255,255,255,0.75) 0%,
          transparent 18%
        ),

        radial-gradient(
          circle at 85% 45%,
          rgba(255,255,255,0.60) 0%,
          transparent 20%
        ),

        /* ターミナルガラス */
        linear-gradient(
          110deg,
          #b9e8fa 0%,
          #e9f8ff 28%,
          #c9ecfb 50%,
          #f5fcff 72%,
          #b7e3f5 100%
        );

      overflow-x: hidden;

      position: relative;
    }


    /*
     * 空港ターミナルのガラス柱
     */
    body::before {

      content: "";

      position: fixed;

      inset: 0;

      pointer-events: none;

      opacity: 0.45;

      background:

        linear-gradient(
          90deg,
          transparent 0%,
          transparent 11%,
          rgba(255,255,255,0.35) 11.2%,
          transparent 11.5%,
          transparent 29%,
          rgba(255,255,255,0.30) 29.2%,
          transparent 29.5%,
          transparent 52%,
          rgba(255,255,255,0.35) 52.2%,
          transparent 52.5%,
          transparent 74%,
          rgba(255,255,255,0.30) 74.2%,
          transparent 74.5%,
          transparent 91%,
          rgba(255,255,255,0.35) 91.2%,
          transparent 91.5%
        );

      z-index: 0;
    }


    /*
     * 空港の床・滑走路をイメージ
     */
    body::after {

      content: "";

      position: fixed;

      left: 0;
      right: 0;
      bottom: 0;

      height: 190px;

      pointer-events: none;

      background:

        /* 下部の空港らしい淡いグラデーションだけを残し、
           画面に白い縦帯が出る装飾は削除 */
        linear-gradient(
          180deg,
          transparent,
          rgba(63,132,160,0.15)
        );

      opacity: 0.55;

      z-index: 0;
    }


    .container {

      position: relative;

      z-index: 1;

      width: min(
        94%,
        760px
      );

      margin:
        0 auto;

      padding:
        24px 0 50px;
    }


    /*
     * 空港案内板っぽいヘッダー
     */

    .airline-header {

      position: relative;

      overflow: hidden;

      margin-bottom: 20px;

      padding:
        28px 24px 30px;

      border-radius:
        24px;

      color: #ffffff;

      background:

        linear-gradient(
          135deg,
          #063e69 0%,
          #0869a8 42%,
          #1197ce 72%,
          #66d0ee 100%
        );

      box-shadow:
        0 18px 45px
        rgba(
          19,
          91,
          135,
          0.30
        );

      border:
        1px solid
        rgba(
          255,
          255,
          255,
          0.25
        );
    }


    /*
     * 案内板の光
     */

    .airline-header::before {

      content: "";

      position: absolute;

      width: 400px;
      height: 400px;

      top: -260px;
      right: -100px;

      border:
        45px solid
        rgba(
          255,
          255,
          255,
          0.10
        );

      border-radius: 50%;
    }


    /*
     * 飛行機
     */

    .airline-header::after {

      content: "✈";

      position: absolute;

      right: 25px;
      bottom: 13px;

      font-size: 58px;

      opacity: 0.17;

      transform:
        rotate(-12deg);
    }


    .airline-small {

      position: relative;

      margin:
        0 0 7px;

      font-size: 11px;

      font-weight: bold;

      letter-spacing:
        0.18em;

      opacity: 0.9;
    }


    .airline-header h1 {

      position: relative;

      margin: 0;

      color: #ffffff;

      font-size: 32px;

      line-height: 1.2;

      letter-spacing:
        0.04em;

      text-align: left;
    }


    .airline-name {

      position: relative;

      margin:
        10px 0 0;

      font-size: 13px;

      letter-spacing:
        0.08em;

      opacity: 0.95;
    }


    .airline-slogan {

      position: relative;

      margin:
        17px 0 0;

      font-size: 12px;

      font-weight: bold;

      letter-spacing:
        0.12em;

      opacity: 0.82;
    }


    /*
     * 空港の案内表示
     */

    .airport-sign {

      display: flex;

      align-items: center;

      gap: 10px;

      margin:
        0 0 14px;

      padding:
        9px 13px;

      border-radius:
        8px;

      color: #ffffff;

      background:
        rgba(
          0,
          35,
          65,
          0.78
        );

      font-size: 10px;

      font-weight: bold;

      letter-spacing:
        0.12em;

      box-shadow:
        0 5px 15px
        rgba(
          0,
          35,
          65,
          0.18
        );
    }


    .airport-sign::before {

      content: "→";

      display: flex;

      align-items: center;

      justify-content: center;

      width: 22px;
      height: 22px;

      border-radius: 50%;

      background:
        #ffffff;

      color:
        #075b91;

      font-size: 14px;
    }


    /*
     * メインの搭乗券
     */

    .reservation-ticket {

      position: relative;

      overflow: hidden;

      background:
        rgba(
          255,
          255,
          255,
          0.97
        );

      border-radius:
        22px;

      box-shadow:
        0 20px 50px
        rgba(
          23,
          99,
          142,
          0.24
        );

      backdrop-filter:
        blur(8px);
    }


    .reservation-ticket::before {

      content: "";

      display: block;

      height: 7px;

      background:
        linear-gradient(
          90deg,
          #063e69,
          #0b78b6,
          #48c9eb,
          #0b78b6,
          #063e69
        );
    }


    .ticket-top {

      display: flex;

      justify-content:
        space-between;

      align-items:
        flex-start;

      gap: 20px;

      padding:
        24px 25px 20px;

      border-bottom:
        1px dashed #a8cfe2;
    }


    .ticket-title {

      margin:
        0 0 5px;

      color: #07588d;

      font-size: 22px;

      font-weight: 800;
    }


    .ticket-subtitle {

      margin: 0;

      color: #7895a8;

      font-size: 11px;

      letter-spacing:
        0.08em;
    }


    .flight-number {

      flex-shrink: 0;

      text-align: right;
    }


    .flight-number span {

      display: block;

      margin-bottom: 2px;

      color: #7693a5;

      font-size: 9px;

      letter-spacing:
        0.12em;
    }


    .flight-number strong {

      display: block;

      color: #075b91;

      font-size: 16px;

      letter-spacing:
        0.04em;
    }


    /*
     * 出発地・目的地
     */

    .route-area {

      display: grid;

      grid-template-columns:
        1fr
        auto
        1fr;

      align-items:
        center;

      gap: 12px;

      padding:
        22px 25px;

      background:
        linear-gradient(
          180deg,
          #f0faff,
          #ffffff
        );
    }


    .route-block {

      text-align: center;
    }


    .route-label {

      display: block;

      margin-bottom: 5px;

      color: #7794a5;

      font-size: 10px;

      letter-spacing:
        0.1em;
    }


    .route-value {

      display: block;

      color: #0a5c91;

      font-size: 28px;

      font-weight: 900;

      letter-spacing:
        0.04em;
    }


    .route-arrow {

      color: #36a5d5;

      font-size: 27px;
    }


    /*
     * 注意事項
     */

    .notice-box {

      margin:
        8px 25px 24px;

      padding:
        20px 20px 18px;

      background:
        linear-gradient(
          135deg,
          #f0faff,
          #e8f7ff
        );

      border:
        2px solid #b7e3fb;

      border-radius:
        18px;

      box-shadow:
        0 5px 16px
        rgba(
          20,
          120,
          180,
          0.08
        );
    }


    .notice-title {

      display: flex;

      align-items:
        center;

      gap: 10px;

      margin-bottom:
        13px;

      color: #07568c;

      font-size: 16px;

      font-weight: 800;
    }


    .notice-icon {

      display: flex;

      align-items:
        center;

      justify-content:
        center;

      width: 30px;
      height: 30px;

      flex-shrink: 0;

      border-radius: 50%;

      background:
        #168dcc;

      color:
        #ffffff;

      font-size: 18px;

      font-weight: 900;
    }


    .notice-list {

      margin: 0;

      padding-left:
        21px;

      color: #124f78;

      font-size: 12px;

      line-height: 1.75;
    }


    .notice-list li {

      padding-left:
        2px;

      margin-bottom:
        6px;
    }


    .notice-list li:last-child {

      margin-bottom:
        0;
    }


    .notice-list li::marker {

      color:
        #159bd8;
    }


    /*
     * 入力フォーム
     */

    .booking-section {

      padding:
        8px 25px 26px;
    }


    .section-heading {

      display: flex;

      align-items:
        center;

      gap: 10px;

      margin:
        8px 0 18px;
    }


    .section-heading-icon {

      display: flex;

      align-items:
        center;

      justify-content:
        center;

      width: 34px;
      height: 34px;

      border-radius: 50%;

      color: #ffffff;

      background:
        linear-gradient(
          135deg,
          #158dcc,
          #075b96
        );

      font-size: 16px;
    }


    .section-heading h2 {

      margin: 0;

      color: #174e70;

      font-size: 18px;
    }


    .section-heading p {

      margin:
        2px 0 0;

      color: #89a0af;

      font-size: 10px;
    }


    .form-field {

      margin-bottom:
        16px;
    }


    label {

      display: block;

      margin:
        0 0 7px;

      color: #315d78;

      font-size: 12px;

      font-weight: 800;

      letter-spacing:
        0.03em;
    }


    input,
    select {

      width: 100%;

      min-height: 50px;

      padding:
        11px 14px;

      border:
        1px solid #c6dfec;

      border-radius:
        11px;

      outline: none;

      background:
        #f9fdff;

      color: #173f59;

      font-family: inherit;

      font-size: 16px;

      transition:
        border-color 0.2s,
        box-shadow 0.2s,
        background 0.2s;
    }


    input::placeholder {

      color: #a5bac7;
    }


    input:focus,
    select:focus {

      border-color:
        #2799d0;

      background:
        #ffffff;

      box-shadow:
        0 0 0 3px
        rgba(
          39,
          153,
          208,
          0.12
        );
    }


    .slot-info {

      min-height: 21px;

      margin:
        -5px 0 12px;

      color: #1883b7;

      font-size: 12px;

      font-weight: bold;

      text-align: right;
    }


    /*
     * 予約ボタン
     */

    #reserve {

      position: relative;

      overflow: hidden;

      width: 100%;

      min-height: 57px;

      margin-top: 4px;

      border: none;

      border-radius:
        13px;

      color: #ffffff;

      background:
        linear-gradient(
          135deg,
          #064d80,
          #078fc9
        );

      font-family: inherit;

      font-size: 17px;

      font-weight: 800;

      letter-spacing:
        0.04em;

      cursor: pointer;

      box-shadow:
        0 9px 23px
        rgba(
          7,
          111,
          171,
          0.30
        );
    }


    #reserve::after {

      content: "✈";

      position: absolute;

      right: 18px;
      top: 50%;

      font-size: 20px;

      opacity: 0.28;

      transform:
        translateY(-50%)
        rotate(-8deg);
    }


    #reserve:disabled {

      opacity: 0.48;

      cursor: not-allowed;

      box-shadow: none;
    }


    .error {

      min-height: 22px;

      margin:
        11px 0 0;

      color: #d14343;

      font-size: 12px;

      font-weight: bold;

      text-align: center;
    }


    /*
     * チケット下部
     */

    .ticket-footer {

      display: flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap: 15px;

      padding:
        16px 25px;

      border-top:
        1px dashed #a8cfe2;

      background:
        #f1faff;
    }


    .ticket-footer-text {

      color: #7591a2;

      font-size: 10px;

      line-height: 1.6;
    }


    .ticket-footer-text strong {

      display: block;

      color: #39708f;

      font-size: 11px;
    }


    /*
     * バーコード
     */

    .barcode {

      display: flex;

      align-items:
        stretch;

      gap: 2px;

      width: 105px;

      height: 34px;

      opacity: 0.55;
    }


    .barcode span {

      display: block;

      height: 100%;

      background:
        #17445f;
    }


    .barcode span:nth-child(1) {
      width: 2px;
    }

    .barcode span:nth-child(2) {
      width: 4px;
    }

    .barcode span:nth-child(3) {
      width: 1px;
    }

    .barcode span:nth-child(4) {
      width: 3px;
    }

    .barcode span:nth-child(5) {
      width: 2px;
    }

    .barcode span:nth-child(6) {
      width: 5px;
    }

    .barcode span:nth-child(7) {
      width: 1px;
    }

    .barcode span:nth-child(8) {
      width: 3px;
    }

    .barcode span:nth-child(9) {
      width: 2px;
    }

    .barcode span:nth-child(10) {
      width: 4px;
    }

    .barcode span:nth-child(11) {
      width: 1px;
    }

    .barcode span:nth-child(12) {
      width: 5px;
    }

    .barcode span:nth-child(13) {
      width: 2px;
    }

    .barcode span:nth-child(14) {
      width: 3px;
    }

    .barcode span:nth-child(15) {
      width: 1px;
    }

    .barcode span:nth-child(16) {
      width: 4px;
    }

    .barcode span:nth-child(17) {
      width: 2px;
    }

    .barcode span:nth-child(18) {
      width: 5px;
    }

    .barcode span:nth-child(19) {
      width: 1px;
    }

    .barcode span:nth-child(20) {
      width: 3px;
    }


    /*
     * 受付停止
     */

    #closedArea {

      position: relative;

      overflow: hidden;

      margin-top: 20px;

      padding:
        30px 24px;

      border:
        1px solid #c7dfeb;

      border-radius:
        20px;

      background:
        rgba(
          255,
          255,
          255,
          0.96
        );

      text-align: center;

      box-shadow:
        0 12px 35px
        rgba(
          30,
          105,
          145,
          0.12
        );
    }


    #closedArea h2 {

      margin:
        0 0 8px;

      color: #17618d;

      font-size: 20px;
    }


    #closedArea p {

      margin: 0;

      color: #7593a5;

      font-size: 13px;
    }


    /*
     * 予約後の搭乗券
     */

    .boarding-pass {

      position: relative;

      overflow: hidden;

      margin-top: 20px;

      background:
        #ffffff;

      border:
        1px solid #c6dfeb;

      border-radius:
        22px;

      box-shadow:
        0 18px 45px
        rgba(
          20,
          102,
          148,
          0.20
        );
    }


    .boarding-pass::before {

      content: "";

      position: absolute;

      top: 0;
      left: 0;
      right: 0;

      height: 7px;

      background:
        linear-gradient(
          90deg,
          #063e69,
          #39b9e6,
          #063e69
        );
    }


    .boarding-pass-header {

      display: flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap: 16px;

      padding:
        29px 24px 20px;

      border-bottom:
        1px dashed #9fc9df;
    }


    .boarding-pass-header h2 {

      margin:
        0 0 5px;

      color: #ffffff;

      font-size: 22px;
    }


    .boarding-pass-header p {

      margin: 0;

      color: #ffffff;

      font-size: 11px;
    }


    .boarding-pass-header > strong {

      color: #ffffff;

      font-size: 24px;

      white-space: nowrap;

      letter-spacing:
        0.05em;
    }


    .boarding-pass-main {

      padding:
        22px 24px;
    }


    .boarding-arrival {

      margin-bottom:
        18px;

      padding:
        17px;

      border-radius:
        13px;

      background:
        linear-gradient(
          135deg,
          #e3f6ff,
          #f5fcff
        );

      text-align: center;
    }


    .boarding-arrival span {

      display: block;

      margin-bottom: 5px;

      color: #66879b;

      font-size: 12px;
    }


    .boarding-arrival strong {

      color: #075d93;

      font-size: 27px;

      letter-spacing:
        0.04em;
    }


    .boarding-info-grid {

      display: grid;

      grid-template-columns:
        repeat(
          2,
          1fr
        );

      gap: 12px;

      margin-bottom:
        18px;
    }


    .boarding-info-grid > div {

      padding:
        13px;

      border:
        1px solid #d5e8f1;

      border-radius:
        10px;

      background:
        #fbfeff;
    }


    .boarding-info-grid span,
    .boarding-pass-passenger span {

      display: block;

      margin-bottom: 5px;

      color: #7693a3;

      font-size: 11px;
    }


    .boarding-info-grid strong {

      color: #194e6d;

      font-size: 16px;
    }


    .boarding-pass-passenger {

      padding:
        15px;

      border-top:
        1px solid #d4e8f3;

      border-bottom:
        1px solid #d4e8f3;
    }


    .boarding-pass-passenger strong {

      color: #0b4f82;

      font-size: 20px;
    }


    .boarding-pass-footer {

      padding:
        18px 24px 24px;
    }


    .boarding-note {

      margin:
        0 0 18px;

      color: #55798e;

      font-size: 13px;

      line-height: 1.7;
    }


    .cancel-reservation {

      width: 100%;

      min-height: 48px;

      border:
        1px solid #c5dce9;

      border-radius:
        10px;

      background:
        #ffffff;

      color: #557286;

      font-family: inherit;

      font-size: 13px;

      font-weight: bold;

      cursor: pointer;
    }


    .cancel-reservation:hover {

      background:
        #f3f9fc;
    }


    /*
     * スマホ
     */

    @media (
      max-width: 600px
    ) {

      .container {

        width: 94%;

        padding:
          14px 0 35px;
      }


      .airline-header {

        padding:
          23px 20px 25px;

        border-radius:
          21px;
      }


      .airline-header h1 {

        font-size: 27px;
      }


      .airline-name {

        font-size: 11px;
      }


      .airline-slogan {

        font-size: 10px;
      }


      .ticket-top {

        padding:
          21px 18px 17px;
      }


      .ticket-title {

        font-size: 19px;
      }


      .flight-number strong {

        font-size: 14px;
      }


      .route-area {

        padding:
          19px 18px;
      }


      .route-value {

        font-size: 24px;
      }


      .route-arrow {

        font-size: 21px;
      }


      .notice-box {

        margin:
          6px 18px 22px;

        padding:
          17px 16px 15px;

        border-radius:
          16px;
      }


      .notice-title {

        font-size: 15px;
      }


      .notice-icon {

        width: 28px;
        height: 28px;

        font-size: 17px;
      }


      .notice-list {

        font-size: 11px;

        line-height: 1.7;
      }


      .booking-section {

        padding:
          5px 18px 21px;
      }


      .ticket-footer {

        padding:
          14px 18px;
      }


      .barcode {

        width: 85px;

        height: 29px;
      }


      .boarding-pass-header {

        padding:
          27px 18px 18px;
      }


      .boarding-pass-header h2 {

        font-size: 19px;
      }


      .boarding-pass-header > strong {

        font-size: 22px;
      }


      .boarding-pass-main {

        padding:
          18px;
      }


      .boarding-arrival strong {

        font-size: 22px;
      }


      .boarding-pass-footer {

        padding:
          16px 18px 20px;
      }

    }


    @media (
      max-width: 360px
    ) {

      .airline-header h1 {

        font-size: 24px;
      }


      .flight-number {

        display: none;
      }


      .route-value {

        font-size: 21px;
      }

    }

  

/* ===== スタッフ.html のインラインCSS ===== */


    /* ==============================
       搭乗状態
    ============================== */

    .reservation-status {

      display: inline-block;

      margin-top: 8px;
      margin-bottom: 8px;

      padding:
        5px 10px;

      border-radius:
        999px;

      font-size: 12px;

      font-weight: bold;
    }


    .reservation-status.reserved {

      color: #17618d;

      background:
        #e5f6ff;

      border:
        1px solid #b8dff0;
    }


    .reservation-status.completed {

      color: #176b4b;

      background:
        #e4f8ee;

      border:
        1px solid #b8dfca;
    }


    /* ==============================
       搭乗済みにするボタン
    ============================== */

    .complete-reservation-button {

      display: inline-block;

      min-height: 44px;

      margin-top: 5px;
      margin-bottom: 8px;

      padding:
        9px 16px;

      border:
        none;

      border-radius:
        10px;

      color: #ffffff;

      background:
        linear-gradient(
          135deg,
          #0877b5,
          #0a9bcf
        );

      font-family: inherit;

      font-size: 14px;

      font-weight: bold;

      cursor: pointer;

      box-shadow:
        0 5px 12px
        rgba(
          7,
          119,
          181,
          0.20
        );
    }


    .complete-reservation-button:active {

      transform:
        translateY(1px);
    }


    .complete-reservation-button:disabled {

      opacity: 0.55;

      cursor: not-allowed;

      box-shadow: none;
    }


    /* ==============================
       予約済み表示
    ============================== */

    .reservation-item {

      margin-bottom:
        14px;
    }

  

/* ===== 統合ページ用 ===== */
.integrated-page-hidden{display:none !important;}

  </style>
</head>
<body>
