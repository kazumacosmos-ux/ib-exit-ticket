function initAdminPage() {
const ADMIN_PASSWORD = "kazuma";

const adminPageRoot =
  document.getElementById("adminPage");

const getAdminElement =
  id =>
    adminPageRoot
      ? adminPageRoot.querySelector("#" + CSS.escape(id))
      : null;

const loginArea =
  getAdminElement("loginArea");

const settingsArea =
  getAdminElement("settingsArea");

const passwordInput =
  getAdminElement("password");

const loginButton =
  getAdminElement("login");

const loginMessage =
  getAdminElement("loginMessage");

const receptionState =
  getAdminElement("receptionState");

const toggleOpen =
  getAdminElement("toggleOpen");

const slotMinutesInput =
  getAdminElement("slotMinutes");

const maxGroupsInput =
  getAdminElement("maxGroups");

const saveSettingsButton =
  getAdminElement("saveSettings");

const day1Button =
  getAdminElement("day1Button");

const day2Button =
  getAdminElement("day2Button");

const currentDayMessage =
  getAdminElement("currentDayMessage");

const settingsMessage =
  getAdminElement("settingsMessage");

const resetAllButton =
  getAdminElement("resetAll");

const resetMessage =
  getAdminElement("resetMessage");

const backToStaffButton =
  getAdminElement("backToStaff");

const logoutButton =
  getAdminElement("logout");

let currentSettings = {
  currentDay: "1",
  start: "09:00",
  end: "15:00",
  slotMinutes: 30,
  maxGroups: 5,
  open: true
};

let adminAuthenticated = false;
let firebaseSigningIn = false;

// ==============================
// 管理者：予約状況
// スタッフ画面と同じ見た目・集計で
// 1日目 / 2日目 / 2日間合計を表示
// ==============================
let adminReservationsData = {};
let adminSlotsData = {};

function createAdminSlots(settings) {
  const start = settings.start || "09:00";
  const end = settings.end || "15:00";
  const minutes = Number(settings.slotMinutes) || 30;

  const toMinutes = time => {
    const [h, m] = String(time).split(":").map(Number);
    return (h || 0) * 60 + (m || 0);
  };
  const formatTime = total => {
    const h = Math.floor(total / 60);
    const m = total % 60;
    return `${String(h).padStart(2, "0")}:${String(m).padStart(2, "0")}`;
  };

  const result = [];
  let current = toMinutes(start);
  const endMinutes = toMinutes(end);
  let index = 0;
  while (current + minutes <= endMinutes && index < 200) {
    const next = current + minutes;
    const slotStart = formatTime(current);
    result.push({
      // スタッフ・お客さん側と同じキー（例: 0900）を使う
      key: slotStart.replace(":", ""),
      start: slotStart,
      end: formatTime(next)
    });
    current = next;
    index++;
  }
  return result;
}

function renderAdminDashboard(targetId, title, day, isTotal = false) {
  const target = getAdminElement(targetId);
  if (!target) return;

  const settings = currentSettings || {};
  const slots = createAdminSlots(settings);
  const maxGroups = Number(settings.maxGroups) || 0;
  const reservations = Object.values(adminReservationsData || {}).filter(r => r);

  let reservationList;
  if (isTotal) {
    reservationList = reservations.filter(r => {
      const d = String(r.day || "1");
      return d === "1" || d === "2";
    });
  } else {
    reservationList = reservations.filter(r => String(r.day || "1") === day);
  }

  const total = reservationList.length;
  const completed = reservationList.filter(r => r.status === "completed").length;
  const reserved = reservationList.filter(r => r.status !== "completed").length;

  let totalCapacity = 0;
  let usedCapacity = 0;
  let fullSlots = 0;

  if (isTotal) {
    for (const slot of slots) {
      const count1 = Number(adminSlotsData?.["1"]?.[slot.key]?.count || 0);
      const count2 = Number(adminSlotsData?.["2"]?.[slot.key]?.count || 0);
      const count = count1 + count2;
      totalCapacity += maxGroups * 2;
      usedCapacity += count;
      if (count >= maxGroups * 2 && maxGroups > 0) fullSlots++;
    }
  } else {
    for (const slot of slots) {
      const count = Number(adminSlotsData?.[day]?.[slot.key]?.count || 0);
      totalCapacity += maxGroups;
      usedCapacity += count;
      if (count >= maxGroups && maxGroups > 0) fullSlots++;
    }
  }

  const remaining = Math.max(0, totalCapacity - usedCapacity);

  target.innerHTML = `
    <section style="
      margin:0;
      padding:18px;
      border-radius:16px;
      background:#f4f8fb;
      border:1px solid #d5e1e9;
    ">
      <div style="font-size:20px;font-weight:700;margin-bottom:14px;">
        📊 ${title}の予約状況
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;">
        <div style="background:#ffffff;border-radius:12px;padding:14px;border:1px solid #dbe5eb;">
          <div style="font-size:13px;color:#657783;">📊 予約総数</div>
          <div style="font-size:27px;font-weight:700;margin-top:4px;">${total}組</div>
        </div>
        <div style="background:#ffffff;border-radius:12px;padding:14px;border:1px solid #dbe5eb;">
          <div style="font-size:13px;color:#657783;">🟢 未搭乗</div>
          <div style="font-size:27px;font-weight:700;margin-top:4px;">${reserved}組</div>
        </div>
        <div style="background:#ffffff;border-radius:12px;padding:14px;border:1px solid #dbe5eb;">
          <div style="font-size:13px;color:#657783;">🔵 搭乗済み</div>
          <div style="font-size:27px;font-weight:700;margin-top:4px;">${completed}組</div>
        </div>
        <div style="background:#ffffff;border-radius:12px;padding:14px;border:1px solid #dbe5eb;">
          <div style="font-size:13px;color:#657783;">🪑 残り枠</div>
          <div style="font-size:27px;font-weight:700;margin-top:4px;">${remaining}組</div>
        </div>
        <div style="background:#ffffff;border-radius:12px;padding:14px;border:1px solid #dbe5eb;">
          <div style="font-size:13px;color:#657783;">🔴 満員枠</div>
          <div style="font-size:27px;font-weight:700;margin-top:4px;">${fullSlots}枠</div>
        </div>
      </div>
      <div style="margin-top:12px;font-size:13px;color:#657783;">
        全${isTotal ? slots.length * 2 : slots.length}枠・最大${totalCapacity}組
      </div>
    </section>
  `;
}

function renderAdminReservationStatus() {
  if (!adminAuthenticated) return;
  renderAdminDashboard("adminDay1Dashboard", "1日目", "1");
  renderAdminDashboard("adminDay2Dashboard", "2日目", "2");
  renderAdminDashboard("adminTotalDashboard", "2日間合計", null, true);
}

onValue(ref(db, "Queue/reservations"), snapshot => {
  adminReservationsData = snapshot.val() || {};
  renderAdminReservationStatus();
});

onValue(ref(db, "Queue/slots"), snapshot => {
  adminSlotsData = snapshot.val() || {};
  renderAdminReservationStatus();
});


// 最初はログイン画面
loginArea.style.display = "block";
settingsArea.style.display = "none";


// ==============================
// 管理者ログイン
// ==============================

loginButton.addEventListener(
  "click",
  async () => {

    const password =
      passwordInput.value.trim();

    loginMessage.textContent = "";

    if (!password) {

      loginMessage.textContent =
        "パスワードを入力してください。";

      return;
    }

    // 管理者パスワード
    if (password !== ADMIN_PASSWORD) {

      loginMessage.textContent =
        "ログインに失敗しました。";

      passwordInput.value = "";
      passwordInput.focus();

      return;
    }

    if (firebaseSigningIn) {
      return;
    }

    firebaseSigningIn = true;
    loginButton.disabled = true;

    try {

      // Firebaseには匿名ユーザーとしてログイン
      await signInAnonymously(auth);

      adminAuthenticated = true;

      loginArea.style.display = "none";
      settingsArea.style.display = "block";
      renderAdminReservationStatus();

      loginMessage.textContent = "";
      passwordInput.value = "";

    } catch (error) {

      console.error(error);

      adminAuthenticated = false;

      settingsArea.style.display = "none";
      loginArea.style.display = "block";

      loginMessage.textContent =
        "ログインに失敗しました。";
    }

    firebaseSigningIn = false;
    loginButton.disabled = false;
  }
);


// ==============================
// Firebaseログイン状態
// ==============================

onAuthStateChanged(
  auth,
  (user) => {

    if (user && adminAuthenticated) {

      loginArea.style.display = "none";
      settingsArea.style.display = "block";

      return;
    }

    if (!user) {

      adminAuthenticated = false;

      loginArea.style.display = "block";
      settingsArea.style.display = "none";
    }
  }
);


// ==============================
// 設定を読み込む
// ==============================

onValue(
  ref(db, "Queue/settings"),
  (snapshot) => {

    const data = snapshot.val();

    if (!data) {
      return;
    }

    currentSettings = {
      ...currentSettings,
      ...data
    };

    updateSettingsScreen();
    renderAdminReservationStatus();
  },
  (error) => {

    console.error(error);
  }
);


// ==============================
// 設定画面を更新
// ==============================

function updateSettingsScreen() {

  const activeDay =
    currentSettings.currentDay === "2"
      ? "2"
      : "1";

  if (currentDayMessage) {
    currentDayMessage.textContent =
      `現在：${activeDay === "1" ? "1日目" : "2日目"}`;
  }

  if (day1Button) {
    day1Button.disabled = activeDay === "1";
    day1Button.textContent =
      activeDay === "1"
        ? "✓ 1日目（現在）"
        : "1日目に切替";
  }

  if (day2Button) {
    day2Button.disabled = activeDay === "2";
    day2Button.textContent =
      activeDay === "2"
        ? "✓ 2日目（現在）"
        : "2日目に切替";
  }

  slotMinutesInput.value =
    currentSettings.slotMinutes;

  maxGroupsInput.value =
    currentSettings.maxGroups;

  if (currentSettings.open) {

    receptionState.textContent =
      "受付中";

    toggleOpen.textContent =
      "受付停止";

  } else {

    receptionState.textContent =
      "受付停止中";

    toggleOpen.textContent =
      "受付再開";
  }
}


// ==============================
// 1日目 / 2日目 切替
// ==============================

async function switchCurrentDay(day) {

  if (!adminAuthenticated) {
    return;
  }

  const nextDay = day === "2" ? "2" : "1";

  if (String(currentSettings.currentDay || "1") === nextDay) {
    return;
  }

  try {
    await update(
      ref(db, "Queue/settings"),
      { currentDay: nextDay }
    );

    currentSettings.currentDay = nextDay;
    updateSettingsScreen();
    settingsMessage.textContent =
      `${nextDay === "1" ? "1日目" : "2日目"}に切り替えました。`;

  } catch (error) {
    settingsMessage.textContent =
      "開催日の切り替えに失敗しました。";
    console.error(error);
  }
}

if (day1Button) {
  day1Button.addEventListener("click", () => switchCurrentDay("1"));
}

if (day2Button) {
  day2Button.addEventListener("click", () => switchCurrentDay("2"));
}


// ==============================
// 受付ON / OFF
// ==============================

toggleOpen.addEventListener(
  "click",
  async () => {

    if (!adminAuthenticated) {
      return;
    }

    const nextOpen =
      !currentSettings.open;

    try {

      await update(
        ref(db, "Queue/settings"),
        {
          open: nextOpen
        }
      );

      currentSettings.open =
        nextOpen;

      updateSettingsScreen();

      settingsMessage.textContent =
        nextOpen
          ? "受付を再開しました。"
          : "受付を停止しました。";

    } catch (error) {

      settingsMessage.textContent =
        "設定変更に失敗しました。";

      console.error(error);
    }
  }
);


// ==============================
// 枠設定を保存
// ==============================

saveSettingsButton.addEventListener(
  "click",
  async () => {

    if (!adminAuthenticated) {
      return;
    }

    const slotMinutes =
      Number(slotMinutesInput.value);

    const maxGroups =
      Number(maxGroupsInput.value);

    if (
      !Number.isInteger(slotMinutes) ||
      slotMinutes < 1
    ) {

      settingsMessage.textContent =
        "1枠の時間を正しく入力してください。";

      return;
    }

    if (
      !Number.isInteger(maxGroups) ||
      maxGroups < 1 ||
      maxGroups > 10
    ) {

      settingsMessage.textContent =
        "最大組数は1〜10組で設定してください。";

      return;
    }

    /*
     * 予約が存在する状態で1枠の時間を変更すると、
     * slotキー（0900, 0930 ...）の意味が変わり、
     * 既存予約・枠数が別の時間枠として扱われる危険がある。
     * そのため、データが残っている間は変更を禁止する。
     */
    const currentSlotMinutes =
      Number(currentSettings.slotMinutes) || 30;

    if (slotMinutes !== currentSlotMinutes) {
      const hasReservations =
        Object.values(adminReservationsData || {}).some(Boolean);

      const hasSlotCounts =
        Object.values(adminSlotsData || {}).some(dayData =>
          dayData &&
          typeof dayData === "object" &&
          Object.values(dayData).some(slotData =>
            Number(slotData?.count || 0) > 0
          )
        );

      if (hasReservations || hasSlotCounts) {
        settingsMessage.textContent =
          "予約または使用済みの枠があるため、1枠の時間は変更できません。変更する場合は先に全予約データをリセットしてください。";
        return;
      }
    }

    try {

      await update(
        ref(db, "Queue/settings"),
        {
          slotMinutes,
          maxGroups
        }
      );

      settingsMessage.textContent =
        "設定を保存しました。";

    } catch (error) {

      settingsMessage.textContent =
        "設定の保存に失敗しました。";

      console.error(error);
    }
  }
);


// ==============================
// 全予約データリセット
// ==============================

resetAllButton.addEventListener(
  "click",
  async () => {

    if (!adminAuthenticated) {
      return;
    }

    const first =
      confirm(
        "本当に全ての予約データを削除しますか？"
      );

    if (!first) {
      return;
    }

    const second =
      confirm(
        "この操作は取り消せません。本当に実行しますか？"
      );

    if (!second) {
      return;
    }

    try {

      await set(
        ref(db, "Queue/reservations"),
        null
      );

      await set(
        ref(db, "Queue/slots"),
        null
      );

      await set(
        ref(db, "Queue/reservationLast"),
        0
      );

      await update(
        ref(db, "Queue/settings"),
        { currentDay: "1" }
      );

      await set(
        ref(db, "Queue/resetAt"),
        Date.now()
      );

      resetMessage.textContent =
        "予約データをすべてリセットしました。";

    } catch (error) {

      resetMessage.textContent =
        "リセットに失敗しました。";

      console.error(error);
    }
  }
);


// ==============================
// スタッフ画面へ
// ==============================

backToStaffButton.addEventListener(
  "click",
  () => {

    window.location.href =
      "?page=staff";
  }
);


// ==============================
// ログアウト
// ==============================

logoutButton.addEventListener(
  "click",
  async () => {

    try {

      await signOut(auth);

    } catch (error) {

      console.error(error);
    }

    adminAuthenticated = false;

    settingsArea.style.display =
      "none";

    loginArea.style.display =
      "block";

    passwordInput.value = "";

    loginMessage.textContent = "";
  }
);
}

const page = new URLSearchParams(window.location.search).get("page");
const customerPage = document.getElementById("customerPage");
const staffPage = document.getElementById("staffPage");
const adminPage = document.getElementById("adminPage");

if (page === "staff") {
  customerPage.classList.add("integrated-page-hidden");
  staffPage.classList.remove("integrated-page-hidden");
  adminPage.classList.add("integrated-page-hidden");
  initStaffPage();
} else if (page === "admin") {
  customerPage.classList.add("integrated-page-hidden");
  staffPage.classList.add("integrated-page-hidden");
  adminPage.classList.remove("integrated-page-hidden");
  initAdminPage();
} else {
  customerPage.classList.remove("integrated-page-hidden");
  staffPage.classList.add("integrated-page-hidden");
  adminPage.classList.add("integrated-page-hidden");
  initCustomerPage();
}

  </script>
</body>
</html>
