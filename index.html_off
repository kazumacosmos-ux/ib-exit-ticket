  <!--
    予約後にJavaScriptが作る搭乗券の
    「TO」という表示を自動的に除去する。
  -->

  <script>

    const removeBoardingPassTO = () => {

      const area =
        document.getElementById(
          "reservationArea"
        );

      if (!area) {
        return;
      }


      const walker =
        document.createTreeWalker(
          area,
          NodeFilter.SHOW_TEXT
        );


      const nodes = [];

      let node;

      while (
        node = walker.nextNode()
      ) {

        if (
          node.textContent.trim() === "TO"
        ) {

          nodes.push(node);

        }

      }


      nodes.forEach(
        (textNode) => {

          textNode.textContent = "";

        }
      );

    };


    const observer =
      new MutationObserver(
        () => {

          removeBoardingPassTO();

        }
      );


    const reservationArea =
      document.getElementById(
        "reservationArea"
      );


    if (reservationArea) {

      observer.observe(
        reservationArea,
        {
          childList: true,
          subtree: true,
          characterData: true
        }
      );

    }


    /*
     * 初回確認
     */

    removeBoardingPassTO();

  </script>
