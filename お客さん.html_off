<!doctype html>
<html lang="ja">

<head>

  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width,initial-scale=1"
  >

  <title>1-B出口 搭乗券予約</title>


  <link
    rel="stylesheet"
    href="./デザイン.css?v=20260909-8"
  >


  <style>

    * {
      box-sizing: border-box;
    }


    html {
      min-height: 100%;
    }


    body {

      margin: 0;

      min-height: 100vh;

      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Helvetica Neue",
        "Yu Gothic",
        "Hiragino Kaku Gothic ProN",
        Meiryo,
        sans-serif;

      color: #123a59;

      /*
       * 空港ターミナルをイメージした背景
       */
      background:

        /* ガラス天井の光 */
        radial-gradient(
          ellipse at 50% -10%,
          rgba(255,255,255,0.95) 0%,
          rgba(255,255,255,0.35) 35%,
          transparent 65%
        ),

        /* 空港の照明 */
        radial-gradient(
          circle at 15% 30%,
          rgba(255,255,255,0.75) 0%,
          transparent 18%
        ),

        radial-gradient(
          circle at 85% 45%,
          rgba(255,255,255,0.60) 0%,
          transparent 20%
        ),

        /* ターミナルガラス */
        linear-gradient(
          110deg,
          #b9e8fa 0%,
          #e9f8ff 28%,
          #c9ecfb 50%,
          #f5fcff 72%,
          #b7e3f5 100%
        );

      overflow-x: hidden;

      position: relative;
    }


    /*
     * 空港ターミナルのガラス柱
     */
    body::before {

      content: "";

      position: fixed;

      inset: 0;

      pointer-events: none;

      opacity: 0.45;

      background:

        linear-gradient(
          90deg,
          transparent 0%,
          transparent 11%,
          rgba(255,255,255,0.35) 11.2%,
          transparent 11.5%,
          transparent 29%,
          rgba(255,255,255,0.30) 29.2%,
          transparent 29.5%,
          transparent 52%,
          rgba(255,255,255,0.35) 52.2%,
          transparent 52.5%,
          transparent 74%,
          rgba(255,255,255,0.30) 74.2%,
          transparent 74.5%,
          transparent 91%,
          rgba(255,255,255,0.35) 91.2%,
          transparent 91.5%
        );

      z-index: 0;
    }


    /*
     * 空港の床・滑走路をイメージ
     */
    body::after {

      content: "";

      position: fixed;

      left: 0;
      right: 0;
      bottom: 0;

      height: 190px;

      pointer-events: none;

      background:

        /* 滑走路中央線 */
        repeating-linear-gradient(
          90deg,
          transparent 0,
          transparent 70px,
          rgba(255,255,255,0.55) 70px,
          rgba(255,255,255,0.55) 120px,
          transparent 120px,
          transparent 190px
        ),

        linear-gradient(
          180deg,
          transparent,
          rgba(63,132,160,0.15)
        );

      opacity: 0.55;

      z-index: 0;
    }


    .container {

      position: relative;

      z-index: 1;

      width: min(
        94%,
        760px
      );

      margin:
        0 auto;

      padding:
        24px 0 50px;
    }


    /*
     * 空港案内板っぽいヘッダー
     */

    .airline-header {

      position: relative;

      overflow: hidden;

      margin-bottom: 20px;

      padding:
        28px 24px 30px;

      border-radius:
        24px;

      color: #ffffff;

      background:

        linear-gradient(
          135deg,
          #063e69 0%,
          #0869a8 42%,
          #1197ce 72%,
          #66d0ee 100%
        );

      box-shadow:
        0 18px 45px
        rgba(
          19,
          91,
          135,
          0.30
        );

      border:
        1px solid
        rgba(
          255,
          255,
          255,
          0.25
        );
    }


    /*
     * 案内板の光
     */

    .airline-header::before {

      content: "";

      position: absolute;

      width: 400px;
      height: 400px;

      top: -260px;
      right: -100px;

      border:
        45px solid
        rgba(
          255,
          255,
          255,
          0.10
        );

      border-radius: 50%;
    }


    /*
     * 飛行機
     */

    .airline-header::after {

      content: "✈";

      position: absolute;

      right: 25px;
      bottom: 13px;

      font-size: 58px;

      opacity: 0.17;

      transform:
        rotate(-12deg);
    }


    .airline-small {

      position: relative;

      margin:
        0 0 7px;

      font-size: 11px;

      font-weight: bold;

      letter-spacing:
        0.18em;

      opacity: 0.9;
    }


    .airline-header h1 {

      position: relative;

      margin: 0;

      color: #ffffff;

      font-size: 32px;

      line-height: 1.2;

      letter-spacing:
        0.04em;

      text-align: left;
    }


    .airline-name {

      position: relative;

      margin:
        10px 0 0;

      font-size: 13px;

      letter-spacing:
        0.08em;

      opacity: 0.95;
    }


    .airline-slogan {

      position: relative;

      margin:
        17px 0 0;

      font-size: 12px;

      font-weight: bold;

      letter-spacing:
        0.12em;

      opacity: 0.82;
    }


    /*
     * 空港の案内表示
     */

    .airport-sign {

      display: flex;

      align-items: center;

      gap: 10px;

      margin:
        0 0 14px;

      padding:
        9px 13px;

      border-radius:
        8px;

      color: #ffffff;

      background:
        rgba(
          0,
          35,
          65,
          0.78
        );

      font-size: 10px;

      font-weight: bold;

      letter-spacing:
        0.12em;

      box-shadow:
        0 5px 15px
        rgba(
          0,
          35,
          65,
          0.18
        );
    }


    .airport-sign::before {

      content: "→";

      display: flex;

      align-items: center;

      justify-content: center;

      width: 22px;
      height: 22px;

      border-radius: 50%;

      background:
        #ffffff;

      color:
        #075b91;

      font-size: 14px;
    }


    /*
     * メインの搭乗券
     */

    .reservation-ticket {

      position: relative;

      overflow: hidden;

      background:
        rgba(
          255,
          255,
          255,
          0.97
        );

      border-radius:
        22px;

      box-shadow:
        0 20px 50px
        rgba(
          23,
          99,
          142,
          0.24
        );

      backdrop-filter:
        blur(8px);
    }


    .reservation-ticket::before {

      content: "";

      display: block;

      height: 7px;

      background:
        linear-gradient(
          90deg,
          #063e69,
          #0b78b6,
          #48c9eb,
          #0b78b6,
          #063e69
        );
    }


    .ticket-top {

      display: flex;

      justify-content:
        space-between;

      align-items:
        flex-start;

      gap: 20px;

      padding:
        24px 25px 20px;

      border-bottom:
        1px dashed #a8cfe2;
    }


    .ticket-title {

      margin:
        0 0 5px;

      color: #07588d;

      font-size: 22px;

      font-weight: 800;
    }


    .ticket-subtitle {

      margin: 0;

      color: #7895a8;

      font-size: 11px;

      letter-spacing:
        0.08em;
    }


    .flight-number {

      flex-shrink: 0;

      text-align: right;
    }


    .flight-number span {

      display: block;

      margin-bottom: 2px;

      color: #7693a5;

      font-size: 9px;

      letter-spacing:
        0.12em;
    }


    .flight-number strong {

      display: block;

      color: #075b91;

      font-size: 16px;

      letter-spacing:
        0.04em;
    }


    /*
     * 出発地・目的地
     */

    .route-area {

      display: grid;

      grid-template-columns:
        1fr
        auto
        1fr;

      align-items:
        center;

      gap: 12px;

      padding:
        22px 25px;

      background:
        linear-gradient(
          180deg,
          #f0faff,
          #ffffff
        );
    }


    .route-block {

      text-align: center;
    }


    .route-label {

      display: block;

      margin-bottom: 5px;

      color: #7794a5;

      font-size: 10px;

      letter-spacing:
        0.1em;
    }


    .route-value {

      display: block;

      color: #0a5c91;

      font-size: 28px;

      font-weight: 900;

      letter-spacing:
        0.04em;
    }


    .route-arrow {

      color: #36a5d5;

      font-size: 27px;
    }


    /*
     * 注意事項
     */

    .notice-box {

      margin:
        8px 25px 24px;

      padding:
        20px 20px 18px;

      background:
        linear-gradient(
          135deg,
          #f0faff,
          #e8f7ff
        );

      border:
        2px solid #b7e3fb;

      border-radius:
        18px;

      box-shadow:
        0 5px 16px
        rgba(
          20,
          120,
          180,
          0.08
        );
    }


    .notice-title {

      display: flex;

      align-items:
        center;

      gap: 10px;

      margin-bottom:
        13px;

      color: #07568c;

      font-size: 16px;

      font-weight: 800;
    }


    .notice-icon {

      display: flex;

      align-items:
        center;

      justify-content:
        center;

      width: 30px;
      height: 30px;

      flex-shrink: 0;

      border-radius: 50%;

      background:
        #168dcc;

      color:
        #ffffff;

      font-size: 18px;

      font-weight: 900;
    }


    .notice-list {

      margin: 0;

      padding-left:
        21px;

      color: #124f78;

      font-size: 12px;

      line-height: 1.75;
    }


    .notice-list li {

      padding-left:
        2px;

      margin-bottom:
        6px;
    }


    .notice-list li:last-child {

      margin-bottom:
        0;
    }


    .notice-list li::marker {

      color:
        #159bd8;
    }


    /*
     * 入力フォーム
     */

    .booking-section {

      padding:
        8px 25px 26px;
    }


    .section-heading {

      display: flex;

      align-items:
        center;

      gap: 10px;

      margin:
        8px 0 18px;
    }


    .section-heading-icon {

      display: flex;

      align-items:
        center;

      justify-content:
        center;

      width: 34px;
      height: 34px;

      border-radius: 50%;

      color: #ffffff;

      background:
        linear-gradient(
          135deg,
          #158dcc,
          #075b96
        );

      font-size: 16px;
    }


    .section-heading h2 {

      margin: 0;

      color: #174e70;

      font-size: 18px;
    }


    .section-heading p {

      margin:
        2px 0 0;

      color: #89a0af;

      font-size: 10px;
    }


    .form-field {

      margin-bottom:
        16px;
    }


    label {

      display: block;

      margin:
        0 0 7px;

      color: #315d78;

      font-size: 12px;

      font-weight: 800;

      letter-spacing:
        0.03em;
    }


    input,
    select {

      width: 100%;

      min-height: 50px;

      padding:
        11px 14px;

      border:
        1px solid #c6dfec;

      border-radius:
        11px;

      outline: none;

      background:
        #f9fdff;

      color: #173f59;

      font-family: inherit;

      font-size: 16px;

      transition:
        border-color 0.2s,
        box-shadow 0.2s,
        background 0.2s;
    }


    input::placeholder {

      color: #a5bac7;
    }


    input:focus,
    select:focus {

      border-color:
        #2799d0;

      background:
        #ffffff;

      box-shadow:
        0 0 0 3px
        rgba(
          39,
          153,
          208,
          0.12
        );
    }


    .slot-info {

      min-height: 21px;

      margin:
        -5px 0 12px;

      color: #1883b7;

      font-size: 12px;

      font-weight: bold;

      text-align: right;
    }


    /*
     * 予約ボタン
     */

    #reserve {

      position: relative;

      overflow: hidden;

      width: 100%;

      min-height: 57px;

      margin-top: 4px;

      border: none;

      border-radius:
        13px;

      color: #ffffff;

      background:
        linear-gradient(
          135deg,
          #064d80,
          #078fc9
        );

      font-family: inherit;

      font-size: 17px;

      font-weight: 800;

      letter-spacing:
        0.04em;

      cursor: pointer;

      box-shadow:
        0 9px 23px
        rgba(
          7,
          111,
          171,
          0.30
        );
    }


    #reserve::after {

      content: "✈";

      position: absolute;

      right: 18px;
      top: 50%;

      font-size: 20px;

      opacity: 0.28;

      transform:
        translateY(-50%)
        rotate(-8deg);
    }


    #reserve:disabled {

      opacity: 0.48;

      cursor: not-allowed;

      box-shadow: none;
    }


    .error {

      min-height: 22px;

      margin:
        11px 0 0;

      color: #d14343;

      font-size: 12px;

      font-weight: bold;

      text-align: center;
    }


    /*
     * チケット下部
     */

    .ticket-footer {

      display: flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap: 15px;

      padding:
        16px 25px;

      border-top:
        1px dashed #a8cfe2;

      background:
        #f1faff;
    }


    .ticket-footer-text {

      color: #7591a2;

      font-size: 10px;

      line-height: 1.6;
    }


    .ticket-footer-text strong {

      display: block;

      color: #39708f;

      font-size: 11px;
    }


    /*
     * バーコード
     */

    .barcode {

      display: flex;

      align-items:
        stretch;

      gap: 2px;

      width: 105px;

      height: 34px;

      opacity: 0.55;
    }


    .barcode span {

      display: block;

      height: 100%;

      background:
        #17445f;
    }


    .barcode span:nth-child(1) {
      width: 2px;
    }

    .barcode span:nth-child(2) {
      width: 4px;
    }

    .barcode span:nth-child(3) {
      width: 1px;
    }

    .barcode span:nth-child(4) {
      width: 3px;
    }

    .barcode span:nth-child(5) {
      width: 2px;
    }

    .barcode span:nth-child(6) {
      width: 5px;
    }

    .barcode span:nth-child(7) {
      width: 1px;
    }

    .barcode span:nth-child(8) {
      width: 3px;
    }

    .barcode span:nth-child(9) {
      width: 2px;
    }

    .barcode span:nth-child(10) {
      width: 4px;
    }

    .barcode span:nth-child(11) {
      width: 1px;
    }

    .barcode span:nth-child(12) {
      width: 5px;
    }

    .barcode span:nth-child(13) {
      width: 2px;
    }

    .barcode span:nth-child(14) {
      width: 3px;
    }

    .barcode span:nth-child(15) {
      width: 1px;
    }

    .barcode span:nth-child(16) {
      width: 4px;
    }

    .barcode span:nth-child(17) {
      width: 2px;
    }

    .barcode span:nth-child(18) {
      width: 5px;
    }

    .barcode span:nth-child(19) {
      width: 1px;
    }

    .barcode span:nth-child(20) {
      width: 3px;
    }


    /*
     * 受付停止
     */

    #closedArea {

      position: relative;

      overflow: hidden;

      margin-top: 20px;

      padding:
        30px 24px;

      border:
        1px solid #c7dfeb;

      border-radius:
        20px;

      background:
        rgba(
          255,
          255,
          255,
          0.96
        );

      text-align: center;

      box-shadow:
        0 12px 35px
        rgba(
          30,
          105,
          145,
          0.12
        );
    }


    #closedArea h2 {

      margin:
        0 0 8px;

      color: #17618d;

      font-size: 20px;
    }


    #closedArea p {

      margin: 0;

      color: #7593a5;

      font-size: 13px;
    }


    /*
     * 予約後の搭乗券
     */

    .boarding-pass {

      position: relative;

      overflow: hidden;

      margin-top: 20px;

      background:
        #ffffff;

      border:
        1px solid #c6dfeb;

      border-radius:
        22px;

      box-shadow:
        0 18px 45px
        rgba(
          20,
          102,
          148,
          0.20
        );
    }


    .boarding-pass::before {

      content: "";

      position: absolute;

      top: 0;
      left: 0;
      right: 0;

      height: 7px;

      background:
        linear-gradient(
          90deg,
          #063e69,
          #39b9e6,
          #063e69
        );
    }


    .boarding-pass-header {

      display: flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap: 16px;

      padding:
        29px 24px 20px;

      border-bottom:
        1px dashed #9fc9df;
    }


    .boarding-pass-header h2 {

      margin:
        0 0 5px;

      color: #075b91;

      font-size: 22px;
    }


    .boarding-pass-header p {

      margin: 0;

      color: #6e8c9d;

      font-size: 11px;
    }


    .boarding-pass-header > strong {

      color: #075b91;

      font-size: 17px;

      white-space: nowrap;

      letter-spacing:
        0.05em;
    }


    .boarding-pass-main {

      padding:
        22px 24px;
    }


    .boarding-arrival {

      margin-bottom:
        18px;

      padding:
        17px;

      border-radius:
        13px;

      background:
        linear-gradient(
          135deg,
          #e3f6ff,
          #f5fcff
        );

      text-align: center;
    }


    .boarding-arrival span {

      display: block;

      margin-bottom: 5px;

      color: #66879b;

      font-size: 12px;
    }


    .boarding-arrival strong {

      color: #075d93;

      font-size: 27px;

      letter-spacing:
        0.04em;
    }


    .boarding-info-grid {

      display: grid;

      grid-template-columns:
        repeat(
          2,
          1fr
        );

      gap: 12px;

      margin-bottom:
        18px;
    }


    .boarding-info-grid > div {

      padding:
        13px;

      border:
        1px solid #d5e8f1;

      border-radius:
        10px;

      background:
        #fbfeff;
    }


    .boarding-info-grid span,
    .boarding-pass-passenger span {

      display: block;

      margin-bottom: 5px;

      color: #7693a3;

      font-size: 11px;
    }


    .boarding-info-grid strong {

      color: #194e6d;

      font-size: 16px;
    }


    .boarding-pass-passenger {

      padding:
        15px;

      border-top:
        1px solid #d4e8f3;

      border-bottom:
        1px solid #d4e8f3;
    }


    .boarding-pass-passenger strong {

      color: #0b4f82;

      font-size: 20px;
    }


    .boarding-pass-footer {

      padding:
        18px 24px 24px;
    }


    .boarding-note {

      margin:
        0 0 18px;

      color: #55798e;

      font-size: 13px;

      line-height: 1.7;
    }


    .cancel-reservation {

      width: 100%;

      min-height: 48px;

      border:
        1px solid #c5dce9;

      border-radius:
        10px;

      background:
        #ffffff;

      color: #557286;

      font-family: inherit;

      font-size: 13px;

      font-weight: bold;

      cursor: pointer;
    }


    .cancel-reservation:hover {

      background:
        #f3f9fc;
    }


    /*
     * スマホ
     */

    @media (
      max-width: 600px
    ) {

      .container {

        width: 94%;

        padding:
          14px 0 35px;
      }


      .airline-header {

        padding:
          23px 20px 25px;

        border-radius:
          21px;
      }


      .airline-header h1 {

        font-size: 27px;
      }


      .airline-name {

        font-size: 11px;
      }


      .airline-slogan {

        font-size: 10px;
      }


      .ticket-top {

        padding:
          21px 18px 17px;
      }


      .ticket-title {

        font-size: 19px;
      }


      .flight-number strong {

        font-size: 14px;
      }


      .route-area {

        padding:
          19px 18px;
      }


      .route-value {

        font-size: 24px;
      }


      .route-arrow {

        font-size: 21px;
      }


      .notice-box {

        margin:
          6px 18px 22px;

        padding:
          17px 16px 15px;

        border-radius:
          16px;
      }


      .notice-title {

        font-size: 15px;
      }


      .notice-icon {

        width: 28px;
        height: 28px;

        font-size: 17px;
      }


      .notice-list {

        font-size: 11px;

        line-height: 1.7;
      }


      .booking-section {

        padding:
          5px 18px 21px;
      }


      .ticket-footer {

        padding:
          14px 18px;
      }


      .barcode {

        width: 85px;

        height: 29px;
      }


      .boarding-pass-header {

        padding:
          27px 18px 18px;
      }


      .boarding-pass-header h2 {

        font-size: 19px;
      }


      .boarding-pass-main {

        padding:
          18px;
      }


      .boarding-arrival strong {

        font-size: 22px;
      }


      .boarding-pass-footer {

        padding:
          16px 18px 20px;
      }

    }


    @media (
      max-width: 360px
    ) {

      .airline-header h1 {

        font-size: 24px;
      }


      .flight-number {

        display: none;
      }


      .route-value {

        font-size: 21px;
      }

    }

  </style>

</head>


<body>


  <main class="container">


    <!-- 空港案内板 -->

    <header class="airline-header">

      <div class="airport-sign">
        Deguchi Dream Skyline
      </div>


      <h1>
        1-B出口 搭乗券予約
      </h1>


      <p class="airline-slogan">
        YOUR JOURNEY STARTS HERE
      </p>

    </header>


    <!-- 予約チケット -->

    <section
      id="bookingArea"
      class="reservation-ticket"
    >


      <div class="ticket-top">

        <div>

          <h2 class="ticket-title">
            搭乗券を予約する
          </h2>

          <p class="ticket-subtitle">
            BOARDING PASS RESERVATION
          </p>

        </div>


        <div class="flight-number">

          <span>
            FLIGHT
          </span>

          <strong>
            DREAM000
          </strong>

        </div>

      </div>


      <div class="route-area">

        <div class="route-block">

          <span class="route-label">
            FROM
          </span>

          <span class="route-value">
            1-B
          </span>

        </div>


        <div class="route-arrow">
          ✈
        </div>


        <div class="route-block">

          <span class="route-label">
            TO
          </span>

          <span class="route-value">
            ？？？
          </span>

        </div>

      </div>


      <!-- ご予約前の注意事項 -->

      <div class="notice-box">

        <div class="notice-title">

          <span class="notice-icon">
            !
          </span>

          <span>
            ご予約前にご確認ください
          </span>

        </div>


        <ul class="notice-list">

          <li>
            1回のご予約につき、1〜4名様までご予約いただけます。
          </li>
　　　　　　　<li>
お一人様につき、同時に1回までご予約いただけます。キャンセルされた場合は、再度ご予約いただけます。
　　　　　　　</li>
          <li>
            搭乗時間前にお越しください。
          </li>

          <li>
            搭乗券は代表者の方のスマートフォンでご提示ください。万が一に備えて、スクリーンショットを撮っておくことをおすすめします。
          </li>

          <li>
            混雑状況により、多少お待ちいただく場合があります。
          </li>

          <li>
            基本的には予約優先ですが、空きがあれば飛び入り参加もできます。
          </li>

        </ul>

      </div>


      <div class="booking-section">


        <div class="section-heading">

          <div class="section-heading-icon">
            ✈
          </div>

          <div>

            <h2>
              搭乗情報を入力
            </h2>

            <p>
              PLEASE ENTER YOUR PASSENGER INFORMATION
            </p>

          </div>

        </div>


        <div class="form-field">

          <label for="name">
            搭乗者代表名
          </label>

          <input
            id="name"
            type="text"
            maxlength="30"
            placeholder="代表者の名前を入力"
          >

        </div>


        <div class="form-field">

          <label for="size">
            搭乗人数
          </label>

          <select id="size">

            <option value="1">
              1名
            </option>

            <option value="2">
              2名
            </option>

            <option value="3">
              3名
            </option>

            <option value="4">
              4名
            </option>

          </select>

        </div>


        <div class="form-field">

          <label for="slot">
            搭乗時間
          </label>


          <select id="slot">

            <option value="09-00">
              09:00 ～ 10:00
            </option>

            <option value="10-00">
              10:00 ～ 11:00
            </option>

            <option value="11-00">
              11:00 ～ 12:00
            </option>

            <option value="12-00">
              12:00 ～ 13:00
            </option>

            <option value="13-00">
              13:00 ～ 14:00
            </option>

            <option value="14-00">
              14:00 ～ 15:00
            </option>

          </select>

        </div>


        <p
          id="slotInfo"
          class="slot-info"
        ></p>


        <button
          id="reserve"
          type="button"
        >
          搭乗券を予約する
        </button>


        <p
          id="error"
          class="error"
        ></p>


      </div>


      <footer class="ticket-footer">

        <div class="ticket-footer-text">

          <strong>
            DEGUCHI DREAM SKYLINE
          </strong>

          1-B GATE　｜　BOARDING PASS

        </div>


        <div
          class="barcode"
          aria-hidden="true"
        >

          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>

        </div>

      </footer>


    </section>


    <section
      id="reservationArea"
      hidden
    ></section>


    <section
      id="closedArea"
      hidden
    >

      <h2>
        現在受付停止中です
      </h2>

      <p>
        スタッフから案内があるまでお待ちください。
      </p>

    </section>


  </main>


  <script
    type="module"
    src="./お客さん.js?v=20260909-9"
  ></script>


  <!--
    予約後にJavaScriptが作る搭乗券の
    「TO」という表示を自動的に除去する。
  -->

  <script>

    const removeBoardingPassTO = () => {

      const area =
        document.getElementById(
          "reservationArea"
        );

      if (!area) {
        return;
      }


      const walker =
        document.createTreeWalker(
          area,
          NodeFilter.SHOW_TEXT
        );


      const nodes = [];

      let node;

      while (
        node = walker.nextNode()
      ) {

        if (
          node.textContent.trim() === "TO"
        ) {

          nodes.push(node);

        }

      }


      nodes.forEach(
        (textNode) => {

          textNode.textContent = "";

        }
      );

    };


    const observer =
      new MutationObserver(
        () => {

          removeBoardingPassTO();

        }
      );


    const reservationArea =
      document.getElementById(
        "reservationArea"
      );


    if (reservationArea) {

      observer.observe(
        reservationArea,
        {
          childList: true,
          subtree: true,
          characterData: true
        }
      );

    }


    /*
     * 初回確認
     */

    removeBoardingPassTO();

  </script>


</body>

</html>
