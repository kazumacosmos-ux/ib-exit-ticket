<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>スタッフ管理</title>

  <link
    rel="stylesheet"
    href="./デザイン.css?v=20260909-8"
  >

  <style>

    /* ==============================
       搭乗状態
    ============================== */

    .reservation-status {

      display: inline-block;

      margin-top: 8px;
      margin-bottom: 8px;

      padding:
        5px 10px;

      border-radius:
        999px;

      font-size: 12px;

      font-weight: bold;
    }


    .reservation-status.reserved {

      color: #17618d;

      background:
        #e5f6ff;

      border:
        1px solid #b8dff0;
    }


    .reservation-status.completed {

      color: #176b4b;

      background:
        #e4f8ee;

      border:
        1px solid #b8dfca;
    }


    /* ==============================
       搭乗済みにするボタン
    ============================== */

    .complete-reservation-button {

      display: inline-block;

      min-height: 44px;

      margin-top: 5px;
      margin-bottom: 8px;

      padding:
        9px 16px;

      border:
        none;

      border-radius:
        10px;

      color: #ffffff;

      background:
        linear-gradient(
          135deg,
          #0877b5,
          #0a9bcf
        );

      font-family: inherit;

      font-size: 14px;

      font-weight: bold;

      cursor: pointer;

      box-shadow:
        0 5px 12px
        rgba(
          7,
          119,
          181,
          0.20
        );
    }


    .complete-reservation-button:active {

      transform:
        translateY(1px);
    }


    .complete-reservation-button:disabled {

      opacity: 0.55;

      cursor: not-allowed;

      box-shadow: none;
    }


    /* ==============================
       予約済み表示
    ============================== */

    .reservation-item {

      margin-bottom:
        14px;
    }

  </style>

</head>

<body>

  <main class="container">

    <h1>スタッフ管理</h1>


    <!-- =========================
         スタッフログイン
    ========================== -->

    <section id="loginArea">

      <h2>スタッフログイン</h2>

      <label for="password">
        パスワード
      </label>

      <input
        id="password"
        type="password"
        autocomplete="current-password"
        placeholder="パスワードを入力"
      >

      <button
        id="login"
        type="button"
      >
        ログイン
      </button>

      <p
        id="loginMessage"
        class="error"
      ></p>

    </section>


    <!-- =========================
         スタッフ管理画面
    ========================== -->

    <section
      id="adminArea"
      style="display:none;"
    >


      <!-- =========================
           受付状況
      ========================== -->

      <h2>受付状況</h2>

      <p>
        現在の受付状況を確認できます。
      </p>

      <p id="receptionState">
        受付中
      </p>


      <hr>


      <!-- =========================
           紙予約
      ========================== -->

      <h2>紙予約を追加</h2>

      <label>
        名前

        <input
          id="paperName"
          type="text"
          placeholder="代表者名など"
        >

      </label>


      <label>
        人数

        <select id="paperSize">

          <option value="1">
            1人
          </option>

          <option value="2">
            2人
          </option>

          <option value="3">
            3人
          </option>

          <option value="4">
            4人
          </option>

        </select>

      </label>


      <label>
        時間枠

        <select id="paperSlot">
        </select>

      </label>


      <p id="paperSlotInfo"></p>


      <button
        id="addPaper"
        type="button"
      >
        紙予約を追加
      </button>


      <p id="paperMessage"></p>


      <hr>


      <!-- =========================
           予約一覧
      ========================== -->

      <h2>予約一覧</h2>

      <div id="slotList">
      </div>


      <hr>


      <!-- =========================
           ログアウト
      ========================== -->

      <button
        id="logout"
        type="button"
      >
        ログアウト
      </button>


      <hr>


      <!-- =========================
           管理者設定
           ★ 一番下
      ========================== -->

      <section>

        <h2>🔐 管理者設定</h2>

        <p>
          受付時間・1枠の時間・最大組数などの
          管理者向け設定を変更します。
        </p>

        <button
          id="openAdminSettings"
          type="button"
        >
          管理者設定を開く
        </button>

      </section>


    </section>

  </main>


  <!--
    バージョン番号を変更して
    古いJavaScriptのキャッシュを避ける
  -->

  <script
    type="module"
    src="./スタッフ.js?v=20260909-8"
  ></script>

</body>
</html>
